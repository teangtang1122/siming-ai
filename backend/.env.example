DATABASE_URL=sqlite:///./novel_agent.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial checkpoint output budget, bounded by the selected model output capacity.
CHECKPOINT_OUTPUT_TOKENS=6000

# TCP / proxy / TLS connection timeout; independent of model response/stream deadlines.
MODEL_CONNECT_TIMEOUT_SECONDS=20
